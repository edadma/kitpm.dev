FROM ubuntu:24.04

# Install JDK and basic tools
RUN apt-get update && apt-get install -y \
    openjdk-21-jdk-headless \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install sbt
RUN curl -fL "https://github.com/sbt/sbt/releases/download/v1.12.9/sbt-1.12.9.tgz" | tar xz -C /usr/local && \
    ln -s /usr/local/sbt/bin/sbt /usr/local/bin/sbt

# Copy Kit source
WORKDIR /kit
COPY . .

# Make adapters executable
RUN chmod +x adapters/*

# Pre-fetch dependencies and compile
RUN sbt "commonJVM/compile" "kitdJVM/compile" "kitJVM/compile"

# Run all tests (tier 0 + 1 + 2)
# Tier 2 tests auto-detect Linux + root and execute; on macOS they cancel
CMD ["sbt", "commonJVM/test", "kitdJVM/test", "kitJVM/test"]
